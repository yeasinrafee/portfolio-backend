generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Status {
  DRAFT
  PUBLISHED
}

enum ReactionType {
  LIKE
  DISLIKE
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String
  avatar               String?
  role                 Role      @default(USER)
  isActive             Boolean   @default(true)
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  comments  Comment[]
  reactions Reaction[]

  @@map("users")
}

model Profile {
  id               String  @id @default(uuid())
  name             String?
  shortDescription String?
  description      String? @db.Text
  avatar           String?
  currentStatus    String?

  email            String?
  primaryPhone     String?
  secondaryPhone   String?
  presentAddress   String?
  permanentAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialLinks SocialLink[]

  @@map("profile")
}

model SocialLink {
  id        String  @id @default(uuid())
  platform  String
  url       String
  icon      String?
  order     Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  @@index([profileId])
  @@map("social_links")
}

model Technology {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  category    String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  projects Project[]

  @@index([category])
  @@map("technologies")
}

model Project {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  description  String    @db.Text
  shortSummary String?
  liveUrl      String?
  repoUrl      String?
  clientName   String?
  category     String?
  featured     Boolean   @default(false)
  order        Int       @default(0)
  status       Status    @default(DRAFT)
  viewCount    Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  ogImage         String?
  canonicalUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       ProjectImage[]
  technologies Technology[]
  comments     Comment[]
  reactions    Reaction[]

  searchVector Unsupported("tsvector")?

  @@index([status, order])
  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(uuid())
  url       String
  alt       String?
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
  @@map("project_images")
}

model Skill {
  id       String  @id @default(uuid())
  name     String
  category String
  icon     String?
  order    Int     @default(0)

  @@index([category])
  @@map("skills")
}

model Experience {
  id          String    @id @default(uuid())
  company     String
  role        String
  location    String?
  description String    @db.Text
  isCurrent   Boolean   @default(false)
  startDate   DateTime
  endDate     DateTime?
  order       Int       @default(0)

  @@map("experiences")
}

model Education {
  id          String    @id @default(uuid())
  institution String
  degree      String
  location    String?
  isCurrent   Boolean   @default(false)
  startDate   DateTime
  endDate     DateTime?
  order       Int       @default(0)

  @@map("educations")
}

model BlogPost {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  excerpt         String?
  content         String   @db.Text
  coverImage      String?
  coverImageAlt   String?
  tags            String[]
  status          Status   @default(DRAFT)
  viewCount       Int      @default(0)
  readingTimeMins Int?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  ogImage         String?
  canonicalUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  Comment[]
  reactions Reaction[]

  searchVector Unsupported("tsvector")?

  @@index([status, createdAt])
  @@map("blog_posts")
}

model Comment {
  id         String  @id @default(uuid())
  content    String  @db.Text
  isApproved Boolean @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  blogPostId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([blogPostId])
  @@map("comments")
}

model Reaction {
  id   String       @id @default(uuid())
  type ReactionType

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  blogPostId String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([blogPostId])
  @@map("reactions")
}

model Testimonial {
  id          String  @id @default(uuid())
  name        String
  designation String?
  company     String?
  message     String  @db.Text
  photo       String?
  rating      Int?
  order       Int     @default(0)

  @@map("testimonials")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_messages")
}
